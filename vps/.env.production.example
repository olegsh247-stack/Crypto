# Copy to .env.production and replace every placeholder. Never commit .env.production.
# Use hex-only secrets so POSTGRES_PASSWORD is safe inside the PostgreSQL URL.
CADDY_DOMAIN=api.example.com
POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
ADMIN_TOKEN=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_48
CORS_ORIGIN=https://app.example.com
WORKER_SCHEDULE_UTC=00:30
BACKUP_DIR_HOST=/var/backups/crypto
BACKUP_RETENTION_DAYS=14
